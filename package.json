{
  "name": "k-qr-scanner",
  "version": "0.3.0",
  "description": "Fast full-screen QR code scanner for the web – scans anywhere in view, any angle, long range with auto-zoom. React, React Native, Vue, Svelte, Angular, plain HTML.",
  "author": "kris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kris-lx/kqrcode.git"
  },
  "homepage": "https://github.com/kris-lx/kqrcode#readme",
  "bugs": {
    "url": "https://github.com/kris-lx/kqrcode/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs",
    "./dist/kqrcode.global.js"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "k-qr-scanner": "./dist/cli.js",
    "kqrcode": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js",
      "require": "./dist/vue.cjs"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js",
      "require": "./dist/svelte.cjs"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "default": "./dist/rn/index.js"
    },
    "./sr": {
      "types": "./dist/sr-entry.d.ts",
      "import": "./dist/sr.js",
      "require": "./dist/sr.cjs"
    },
    "./models/wechat_sr.onnx": "./models/wechat_sr.onnx",
    "./app.plugin.js": {
      "types": "./app.plugin.d.ts",
      "default": "./app.plugin.js"
    }
  },
  "files": [
    "dist",
    "react-native/package.json",
    "app.plugin.js",
    "app.plugin.d.ts",
    "models/wechat_sr.onnx",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "licenses",
    "llms.txt"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json && node scripts/prune-types.mjs",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "bench": "tsx bench/run.mts && tsx bench/update-readme.mts",
    "bench:readme": "tsx bench/update-readme.mts"
  },
  "peerDependencies": {
    "react": ">=17",
    "vue": ">=3",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "react-native": {
      "optional": true
    },
    "react-native-webview": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "jsqr": "^1.4.0",
    "onnxruntime-node": "^1.20.1",
    "onnxruntime-web": "^1.20.1",
    "playwright-core": "^1.65.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vue": "^3.5.0",
    "zxing-wasm": "^3.1.7"
  },
  "license": "MIT",
  "keywords": [
    "qr",
    "qrcode",
    "scanner",
    "barcode",
    "camera",
    "wechat",
    "alipay",
    "zxing",
    "webgpu",
    "web-component",
    "react",
    "vue",
    "svelte",
    "react-native",
    "angular"
  ],
  "engines": {
    "node": ">=18"
  }
}
